<div id="header" class="flex justify-between w-full px-6 py-3 items-center">
  <div class="flex gap-4">
    <% if current_page.url == '/' && !config.hide_filters %>
      <button onclick="toggleSidebar()" class="text-white cursor-pointer outline-hidden">
        <span id="menu-icon"><%= icon 'menu' %></span>
        <span id="close-icon" class="hidden"><%= icon 'close' %></span>
      </button>
    <% end %>

    <% if config.logo %>
      <a href="/"><%= image_tag config.logo %></a>
    <% else %>
      <a href="/" class="text-2xl text-white!"><%= config.title %></a>
    <% end %>
  </div>
  <div class="flex gap-4">
    <div class="hidden sm:inline">
      <% menu_links.each do |link| %>
        <a href="<%= link[:url] %>" class="nav-link"><%= link[:text] %></a>
      <% end %>
    </div>
    
    <% if menu_links.any? %>
      <div class="relative sm:hidden">
        <button onclick="toggleMobileMenu()" class="text-white cursor-pointer outline-hidden p-2">
          <span id="mobile-menu-icon"><%= icon 'chevron-down' %></span>
          <span id="mobile-close-icon" class="hidden"><%= icon 'close' %></span>
        </button>
        
        <div id="mobile-menu-dropdown" class="dropdown hidden">
          <% menu_links.each do |link| %>
            <a href="<%= link[:url] %>" class="mobile-nav-link"><%= link[:text] %></a>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
