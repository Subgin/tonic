---
layout: layout
---

<% @title = "Collection Statistics" %>
<% @description = "Statistics and insights for the #{config.title} collection" %>

<div class="mt-24 mb-24 px-8 md:px-32 mx-auto max-w-screen-xl">
  <div class="flex justify-between items-center mb-6">
    <a href="#" onclick="back('/')" class="flex items-center text-blue-600 hover:text-blue-800">
      <%= inline_svg 'icons/chevron-left.svg', class: 'w-4 h-4 mr-1' %> Back to Collection
    </a>
  </div>

  <div class="text-center mb-8">
    <h1 class="text-4xl font-bold mb-2">📊 Collection Insights</h1>
    <p class="text-gray-600"><%= config.title %></p>
  </div>

  <% stats = collection_stats %>
  
  <!-- Overview Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-blue-600 mb-2"><%= stats[:total_items] %></div>
      <div class="text-gray-600">Total Items</div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-green-600 mb-2"><%= stats[:unique_fields] %></div>
      <div class="text-gray-600">Unique Fields</div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-purple-600 mb-2"><%= all_categories(tonic_collection).size %></div>
      <div class="text-gray-600">Categories</div>
    </div>
  </div>

  <!-- Field Statistics -->
  <div class="space-y-8">
    <% collection_fields.each do |field| %>
      <% field_stats = field_statistics(field) %>
      <% next if field_stats[:type] == 'empty' %>
      
      <div class="bg-white rounded-lg shadow-md p-6">
        <h3 class="text-xl font-semibold mb-4 flex items-center">
          <span class="mr-2">
            <% case field_stats[:type] %>
            <% when 'numeric' %>📊
            <% when 'categorical' %>🏷️
            <% when 'tags' %>🔖
            <% when 'date' %>📅
            <% when 'boolean' %>✅
            <% else %>📝
            <% end %>
          </span>
          <%= field.titleize %>
          <span class="ml-2 text-sm bg-gray-200 px-2 py-1 rounded"><%= field_stats[:type] %></span>
        </h3>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <!-- Stats Summary -->
          <div>
            <div class="mb-4">
              <div class="text-sm text-gray-600">Coverage: <%= field_stats[:non_empty_items] %> / <%= field_stats[:total_items] %> items 
                (<%= ((field_stats[:non_empty_items].to_f / field_stats[:total_items]) * 100).round(1) %>%)</div>
            </div>
            
            <% case field_stats[:type] %>
            <% when 'numeric' %>
              <div class="space-y-2">
                <div><strong>Range:</strong> <%= field_stats[:min] %> - <%= field_stats[:max] %></div>
                <div><strong>Average:</strong> <%= field_stats[:avg] %></div>
                <div><strong>Median:</strong> <%= field_stats[:median] %></div>
              </div>
            <% when 'categorical' %>
              <div class="space-y-2">
                <div><strong>Unique Values:</strong> <%= field_stats[:unique_values] %></div>
                <div><strong>Most Common:</strong></div>
                <ul class="ml-4 space-y-1">
                  <% field_stats[:most_common].each do |value, count| %>
                    <li class="flex justify-between">
                      <span><%= value %></span>
                      <span class="text-gray-500"><%= count %></span>
                    </li>
                  <% end %>
                </ul>
              </div>
            <% when 'tags' %>
              <div class="space-y-2">
                <div><strong>Total Tags:</strong> <%= field_stats[:total_tags] %></div>
                <div><strong>Unique Tags:</strong> <%= field_stats[:unique_tags] %></div>
                <div><strong>Most Popular Tags:</strong></div>
                <div class="flex flex-wrap gap-2 mt-2">
                  <% field_stats[:most_common_tags].first(8).each do |tag, count| %>
                    <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-sm">
                      <%= tag %> (<%= count %>)
                    </span>
                  <% end %>
                </div>
              </div>
            <% when 'date' %>
              <% if field_stats[:earliest] %>
                <div class="space-y-2">
                  <div><strong>Date Range:</strong> <%= field_stats[:earliest] %> to <%= field_stats[:latest] %></div>
                  <div><strong>Span:</strong> <%= field_stats[:date_range_days] %> days</div>
                  <% if field_stats[:dates_by_year].any? %>
                    <div><strong>By Year:</strong></div>
                    <div class="grid grid-cols-2 gap-2 mt-2">
                      <% field_stats[:dates_by_year].sort.each do |year, count| %>
                        <div class="flex justify-between text-sm">
                          <span><%= year %></span>
                          <span><%= count %></span>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            <% when 'boolean' %>
              <div class="space-y-2">
                <div class="flex justify-between">
                  <span><strong>True:</strong></span>
                  <span><%= field_stats[:true_count] %> (<%= field_stats[:true_percentage] %>%)</span>
                </div>
                <div class="flex justify-between">
                  <span><strong>False:</strong></span>
                  <span><%= field_stats[:false_count] %> (<%= (100 - field_stats[:true_percentage]).round(1) %>%)</span>
                </div>
              </div>
            <% else %>
              <div class="space-y-2">
                <div><strong>Unique Values:</strong> <%= field_stats[:unique_values] %></div>
                <div><strong>Avg Length:</strong> <%= field_stats[:avg_length].round(1) %> characters</div>
              </div>
            <% end %>
          </div>
          
          <!-- Chart Area -->
          <div>
            <% case field_stats[:type] %>
            <% when 'categorical' %>
              <canvas id="chart-<%= field.parameterize %>" width="300" height="200"></canvas>
              <script>
                document.addEventListener('DOMContentLoaded', function() {
                  const ctx = document.getElementById('chart-<%= field.parameterize %>').getContext('2d');
                  new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                      labels: <%= field_stats[:value_distribution].keys.to_json.html_safe %>,
                      datasets: [{
                        data: <%= field_stats[:value_distribution].values.to_json.html_safe %>,
                        backgroundColor: [
                          '#3B82F6', '#EF4444', '#10B981', '#F59E0B', '#8B5CF6',
                          '#EC4899', '#06B6D4', '#84CC16', '#F97316', '#6366F1'
                        ]
                      }]
                    },
                    options: {
                      responsive: true,
                      plugins: {
                        legend: { position: 'bottom' }
                      }
                    }
                  });
                });
              </script>
            <% when 'numeric' %>
              <canvas id="chart-<%= field.parameterize %>" width="300" height="200"></canvas>
              <script>
                document.addEventListener('DOMContentLoaded', function() {
                  const ctx = document.getElementById('chart-<%= field.parameterize %>').getContext('2d');
                  const values = <%= fetch_values(field).to_json.html_safe %>;
                  const bins = 10;
                  const min = Math.min(...values);
                  const max = Math.max(...values);
                  const binSize = (max - min) / bins;
                  
                  const histogram = new Array(bins).fill(0);
                  const labels = [];
                  
                  for (let i = 0; i < bins; i++) {
                    const binStart = min + i * binSize;
                    const binEnd = min + (i + 1) * binSize;
                    labels.push(`${binStart.toFixed(1)}-${binEnd.toFixed(1)}`);
                  }
                  
                  values.forEach(value => {
                    const binIndex = Math.min(Math.floor((value - min) / binSize), bins - 1);
                    histogram[binIndex]++;
                  });
                  
                  new Chart(ctx, {
                    type: 'bar',
                    data: {
                      labels: labels,
                      datasets: [{
                        label: 'Frequency',
                        data: histogram,
                        backgroundColor: '#3B82F6'
                      }]
                    },
                    options: {
                      responsive: true,
                      plugins: {
                        legend: { display: false }
                      },
                      scales: {
                        y: { beginAtZero: true }
                      }
                    }
                  });
                });
              </script>
            <% when 'boolean' %>
              <canvas id="chart-<%= field.parameterize %>" width="300" height="200"></canvas>
              <script>
                document.addEventListener('DOMContentLoaded', function() {
                  const ctx = document.getElementById('chart-<%= field.parameterize %>').getContext('2d');
                  new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                      labels: ['True', 'False'],
                      datasets: [{
                        data: [<%= field_stats[:true_count] %>, <%= field_stats[:false_count] %>],
                        backgroundColor: ['#10B981', '#EF4444']
                      }]
                    },
                    options: {
                      responsive: true,
                      plugins: {
                        legend: { position: 'bottom' }
                      }
                    }
                  });
                });
              </script>
            <% when 'date' %>
              <% if field_stats[:dates_by_year] && field_stats[:dates_by_year].any? %>
                <canvas id="chart-<%= field.parameterize %>" width="300" height="200"></canvas>
                <script>
                  document.addEventListener('DOMContentLoaded', function() {
                    const ctx = document.getElementById('chart-<%= field.parameterize %>').getContext('2d');
                    const yearData = <%= field_stats[:dates_by_year].sort.to_h.to_json.html_safe %>;
                    
                    new Chart(ctx, {
                      type: 'line',
                      data: {
                        labels: Object.keys(yearData),
                        datasets: [{
                          label: 'Items per Year',
                          data: Object.values(yearData),
                          borderColor: '#3B82F6',
                          backgroundColor: 'rgba(59, 130, 246, 0.1)',
                          fill: true
                        }]
                      },
                      options: {
                        responsive: true,
                        plugins: {
                          legend: { display: false }
                        },
                        scales: {
                          y: { beginAtZero: true }
                        }
                      }
                    });
                  });
                </script>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Fallback if Chart.js fails to load from CDN
if (typeof Chart === 'undefined') {
  console.warn('Chart.js failed to load from CDN');
  document.querySelectorAll('canvas').forEach(canvas => {
    canvas.parentElement.innerHTML = '<div class="text-center text-gray-500 p-4 border border-gray-200 rounded">Chart visualization unavailable (Chart.js not loaded)</div>';
  });
}
</script>