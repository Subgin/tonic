---
layout: layout
---

<% @title = "Collection Statistics" %>
<% @description = "Statistics for the collection" %>

<div class="mt-24 mb-24 px-8 md:px-32 mx-auto max-w-screen-xl">
  <div class="flex justify-between items-center mb-6">
    <a href="#" onclick="back('/')" class="flex items-center text-blue-600 hover:text-blue-800">
      <%= inline_svg 'icons/chevron-left.svg', class: 'w-4 h-4 mr-1' %> Back to Collection
    </a>
  </div>

  <div class="text-center mb-8">
    <h1 class="text-4xl font-bold mb-2">📊 Collection Insights</h1>
    <p class="text-gray-600"><%= config.title %></p>
  </div>

  <% collection_data = tonic_collection %>
  
  <!-- Overview Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-blue-600 mb-2"><%= collection_data.size %></div>
      <div class="text-gray-600">Total Items</div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-green-600 mb-2"><%= collection_data.flat_map(&:keys).uniq.size %></div>
      <div class="text-gray-600">Unique Fields</div>
    </div>
    <div class="bg-white rounded-lg shadow-md p-6 text-center">
      <div class="text-3xl font-bold text-purple-600 mb-2"><%= all_categories(collection_data).size %></div>
      <div class="text-gray-600">Categories</div>
    </div>
  </div>

  <!-- Simple Content -->
  <div class="bg-white rounded-lg shadow-md p-6">
    <h3 class="text-xl font-semibold mb-4">📋 Collection Overview</h3>
    <p>This statistics page provides insights into the collection data structure and content.</p>
  </div>
</div>