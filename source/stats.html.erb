---
layout: layout
---

<% @title = "Collection Statistics & Insights" %>
<% stats = collection_stats %>

<div class="mt-24 mb-24 px-8 md:px-32 mx-auto max-w-screen-xl">
  <div class="flex justify-between items-center mb-4">
    <a href="#" onclick="back('/')">
      <%= inline_svg 'icons/chevron-left.svg' %> Back
    </a>
    <% unless config.hide_sharing %>
      <%= partial 'templates/components/sharing', locals: { extra_classes: 'right-5 md:right-32 top-32' } %>
    <% end %>
  </div>

  <h1><%= @title %></h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-4 mb-8">
    <div class="card">
      <div class="card-body text-center">
        <div class="text-3xl font-bold text-gray-800"><%= stats[:total_items] %></div>
        <div class="text-sm text-gray-600">Total items</div>
      </div>
    </div>
    <div class="card">
      <div class="card-body text-center">
        <div class="text-3xl font-bold text-gray-800"><%= stats[:unique_fields] %></div>
        <div class="text-sm text-gray-600">Unique attributes</div>
      </div>
    </div>
    <div class="card">
      <div class="card-body text-center">
        <div class="text-3xl font-bold text-gray-800"><%= all_categories(tonic_collection).size %></div>
        <div class="text-sm text-gray-600">Categories</div>
      </div>
    </div>
  </div>

  <h2>Attributes Analysis</h2>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-4 mb-8">
    <% stats[:field_stats].each do |field, field_data| %>
      <div class="card">
        <div class="card-header">
          <h3 class="text-lg">
            <%= field.titleize %>
            <span class="inline-block px-2 py-1 text-xs rounded-full bg-gray-200 text-gray-700">
              <%= field_data[:type] %>
            </span>
          </h3>
        </div>
        <div class="card-body">
          <% field_stats = field_data[:stats] %>

          <div class="text-sm text-gray-600 mb-3">
            <%= field_stats[:total_entries] %> entries
          </div>

          <% case field_data[:type] %>
          <% when 'categorical' %>
            <div class="mb-2">
              <strong>Unique values:</strong> <%= field_stats[:unique_values] %>
            </div>
            <% if field_stats[:most_common] %>
              <div>
                <strong>Most common:</strong>
                <ul class="mt-1">
                  <% field_stats[:most_common].first(3).each do |value, count| %>
                    <li class="text-sm">
                      <%= value %> (<%= count %>)
                    </li>
                  <% end %>
                </ul>
              </div>
            <% end %>

          <% when 'numeric' %>
            <div class="grid grid-cols-2 gap-2 text-sm">
              <div><strong>Min:</strong> <%= field_stats[:min] %></div>
              <div><strong>Max:</strong> <%= field_stats[:max] %></div>
              <div><strong>Average:</strong> <%= field_stats[:average] %></div>
              <div><strong>Unique:</strong> <%= field_stats[:unique_values] %></div>
            </div>

          <% when 'array' %>
            <div class="mb-2">
              <strong>Total unique values:</strong> <%= field_stats[:total_unique_values] %>
            </div>
            <div class="mb-2">
              <strong>Avg items per entry:</strong> <%= field_stats[:avg_items_per_entry] %>
            </div>
            <% if field_stats[:most_common] %>
              <div>
                <strong>Most common:</strong>
                <div class="mt-1">
                  <%= render_tags(field_stats[:most_common].keys.first(5)) %>
                </div>
              </div>
            <% end %>

          <% when 'date' %>
            <div class="text-sm">
              <div><strong>Date range:</strong></div>
              <div><%= field_stats[:earliest] %> to <%= field_stats[:latest] %></div>
              <div class="mt-1"><strong>Unique dates:</strong> <%= field_stats[:unique_dates] %></div>
            </div>

          <% when 'boolean' %>
            <div class="text-sm">
              <div>True: <%= field_stats[:true_count] %> (<%= field_stats[:true_percentage] %>%)</div>
              <div>False: <%= field_stats[:false_count] %> (<%= 100 - field_stats[:true_percentage] %>%)</div>
            </div>

          <% else %>
            <div class="text-sm">
              <div><strong>Unique values:</strong> <%= field_stats[:unique_values] %></div>
              <% if field_stats[:most_common] %>
                <div class="mt-1">
                  <strong>Most common:</strong>
                  <ul>
                    <% field_stats[:most_common].first(2).each do |value, count| %>
                      <li><%= strip_truncate(value.to_s, 30) %> (<%= count %>)</li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Category Breakdown -->
  <% if all_categories(tonic_collection).any? %>
    <h2>Category Breakdown</h2>
    <div class="card mt-4 mb-8">
      <div class="card-body">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 p-2">
          <% all_categories(tonic_collection).each do |category| %>
            <% items_count = items_for_category(category).size %>
            <div class="flex justify-between items-center p-3 border border-gray-500 rounded">
              <div>
                <a href="<%= category_page_url(category) %>" class="font-medium hover:underline">
                  <%= category %>
                </a>
              </div>
              <div class="text-sm text-gray-600">
                <%= items_count %> item<%= 's' if items_count > 1 %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
